# Copy this file to .env. Never commit the real .env file.
IBKR_HOST=127.0.0.1
IBKR_PORT=7496
IBKR_CLIENT_ID=41
IBKR_ACCOUNT=
IBKR_TIMEOUT_SECONDS=8
IBKR_MARKET_DATA_TYPE=3
IBKR_VOLATILITY_MODE=mock
IBKR_VOLATILITY_WAIT_SECONDS=3
IBKR_OPTION_STRIKE_COUNT=7
VOLATILITY_WATCHLIST=NVDA,SPY,QQQ,AAPL,MSFT
IBKR_US_STOCK_VOLUME_MULTIPLIER=1
DAILY_QUANT_LOOKBACK_YEARS=3
TREND_LINE_DEFAULT_LOOKBACK=120

DATABASE_PATH=data/investment.duckdb
OPENBB_ENABLED=false
OPENBB_HISTORY_PROVIDER=yfinance
APP_DEFAULT_SYMBOL=NVDA
APP_LOG_LEVEL=INFO

# SEC_MODE: mock (safe demo), online (SEC EDGAR), or offline (local cache only).
SEC_MODE=mock
# Required only for online mode. Use your real application name and contact email.
SEC_USER_AGENT=InvestmentResearchApp/1.0 your.name@yourdomain.com
SEC_REQUESTS_PER_SECOND=5
SEC_TIMEOUT_SECONDS=20
SEC_MAX_RETRIES=3
SEC_CACHE_DIR=data/sec_cache

# Phase E macro data: mock, online, or offline (DuckDB only).
MACRO_MODE=mock
# Optional. Required for FRED series such as UMCSENT.
FRED_API_KEY=
# Optional; BLS supports limited unregistered requests.
BLS_REGISTRATION_KEY=
PHASE_E_COMPANIES=MSFT,AMZN,GOOGL,META

# Phase F-A liquidity data: mock, online (FRED), or offline (DuckDB only).
LIQUIDITY_MODE=mock
LIQUIDITY_LOOKBACK_YEARS=10

# Phase F-B market confirmation: mock, tws (read-only IBKR), or offline.
MARKET_CONFIRMATION_MODE=mock
MARKET_CONFIRMATION_LOOKBACK_YEARS=3
MARKET_CONFIRMATION_BASKET=SPY,QQQ,IWM,TLT,HYG,LQD,GLD,UUP
